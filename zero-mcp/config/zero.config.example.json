{
  "$schema": "./zero.config.schema.json",
  "modules": {
    "zero": { "enabled": true },
    "project": { "enabled": true },
    "security": { "enabled": true, "ratePerMinute": 30 },
    "github": { "enabled": true, "ratePerMinute": 20, "sessionQuota": 300 },
    "catalog": { "enabled": true, "tools": { "catalog_render_mcp_json": "allow" } }
  },
  "filesystem": {
    "allowedRoots": ["."],
    "denySegments": [".git", "node_modules", ".ssh", ".gnupg", ".aws"],
    "maxFileBytes": 1000000,
    "maxFiles": 2000
  },
  "network": {
    "enabled": true,
    "allowedHosts": ["api.github.com", "registry.npmjs.org"],
    "timeoutMs": 15000,
    "maxResponseBytes": 5000000
  },
  "audit": { "enabled": true, "path": ".zero/audit.jsonl" }
}
