{
  "name": "afterlight-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AFTERLIGHT — psychological first-person horror for mobile browsers. Chapter 01: 03:17",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && vite build",
