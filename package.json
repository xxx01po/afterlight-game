    "three": "^0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
