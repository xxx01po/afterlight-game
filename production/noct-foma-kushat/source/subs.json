[
 {"t0":3.50,"t1":4.65,"text":"(за дверью) Фома, кушать!"},
 {"t0":4.75,"t1":6.35,"text":"Ща, мам, иду!"},
 {"t0":7.20,"t1":8.75,"text":"*ФОМА! КУШАТЬ!*"},
 {"t0":8.85,"t1":10.20,"text":"Одну минуточку!"},
 {"t0":11.40,"t1":14.00,"text":"Она…\n*замолчала.*"},
 {"t0":15.30,"t1":17.35,"text":"*Нет. Нет-нет-нет!*"},
 {"t0":19.60,"t1":21.80,"text":"Мам, ты мешаешь\n*финалу!*"},
 {"t0":24.10,"t1":26.60,"text":"Прости, мам.\nЭто *финал*."},
 {"t0":30.00,"t1":31.85,"text":"*Бан.* На неделю."},
 {"t0":33.00,"t1":33.95,"text":"…*Справедливо.*"}
