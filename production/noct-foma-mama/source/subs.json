[
 {"t0":1.95,"t1":3.82,"text":"Так. Просто *сотру*."},
 {"t0":5.60,"t1":7.58,"text":"Ой. Стало *хуже*."},
 {"t0":7.90,"t1":8.96,"text":"*В МОРОЗИЛКУ!*"},
 {"t0":10.30,"t1":12.13,"text":"Ешь, *хороший мальчик*!"},
 {"t0":13.60,"t1":14.48,"text":"*МАМА?!*"},
 {"t0":18.90,"t1":20.58,"text":"Как спрятать *дневник*?"},
 {"t0":20.60,"t1":22.78,"text":"Я свой *съел*."},
 {"t0":23.60,"t1":24.55,"text":"*Невкусно.*"},
 {"t0":25.00,"t1":25.48,"text":"*Всё, бегу!*"},
 {"t0":26.00,"t1":27.07,"text":"*Куда собрался?*"},
 {"t0":27.30,"t1":29.10,"text":"Двойка —\nтолько у тебя."},
 {"t0":29.10,"t1":31.35,"text":"У всех остальных —\n*КОЛ*."},
 {"t0":31.50,"t1":32.59,"text":"*Я гений.*"},
 {"t0":32.85,"t1":34.86,"text":"Но дневник\nты *съел*."}
]
