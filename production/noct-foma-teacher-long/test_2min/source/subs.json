[
{
"t0": 0.2,
"t1": 2.375,
"text": "Меня зовут Фома. Мне *тринадцать*."
},
{
"t0": 2.375,
"t1": 4.18,
"text": "И сегодня я — *учитель*."
},
{
"t0": 4.18,
"t1": 7.54,
"text": "Если директор узнает —\nменя *исключат*."
},
{
"t0": 9.14,
"t1": 13.075,
"text": "Шесть уроков. Один день.\nА в пять — *кабинет директора*."
},
{
"t0": 13.075,
"t1": 14.43,
"text": "*ФОМА ИВАНОВИЧ!*"
},
{
"t0": 15.88,
"t1": 17.255,
"text": "(за дверью) Фома! В школу!"
},
{
"t0": 17.255,
"t1": 19.985,
"text": "Кхе-кхе. Мам...\nу меня температура."
},
{
"t0": 19.985,
"t1": 23.37,
"text": "Градусник показывает *36,6*!"
},
{
"t0": 23.37,
"t1": 25.64,
"text": "Это... у градусника температура."
},
{
"t0": 25.64,
"t1": 27.825,
"text": "*Фома! В школу! Сейчас же!*"
},
{
"t0": 27.825,
"t1": 30.675,
"text": "Мам... меня вчера\nперепутали с учителем."
},
{
"t0": 30.675,
"t1": 33.405,
"text": "Тем более!\n*Учителей не прогуливают!*"
},
{
"t0": 34.005,
"t1": 34.815,
"text": "…*Логично.*"
},
{
"t0": 35.715,
"t1": 37.255,
"text": "Она что, *в курсе?!*"
},
{
"t0": 37.705,
"t1": 40.96,
"text": "Коллега! Наконец-то!\nВот ваш бейджик!"
},
{
"t0": 41.96,
"t1": 45.095,
"text": "Завуч и учитель... всего?\nЭто чего — всего?"
},
{
"t0": 45.095,
"t1": 49.55,
"text": "Всего! У нас нехватка кадров.\nСегодня у вас шесть уроков!"
},
{
"t0": 49.55,
"t1": 51.745,
"text": "Шесть?! Да я сам в *седьмом кла…*"
},
{
"t0": 51.745,
"t1": 54.0,
"text": "…в седьмом\nклассе *преподаю*. Иногда."
},
{
"t0": 54.6,
"t1": 59.895,
"text": "Только осторожно. Директор проверяет\nновеньких. Вчера одного даже исключили."
},
{
"t0": 59.895,
"t1": 61.9,
"text": "Учителя? Исключили?"
},
{
"t0": 61.9,
"t1": 64.105,
"text": "Ну, он оказался… *учеником!*"
},
{
"t0": 64.905,
"t1": 70.165,
"text": "Вот ваш кабинет. Вот журнал. А\nвот кнопка тревоги — не нажимайте."
},
{
"t0": 70.165,
"t1": 71.01,
"text": "А если нажать?"
},
{
"t0": 71.01,
"t1": 72.015,
"text": "*Не нажимайте!*"
},
{
"t0": 73.615,
"t1": 77.37,
"text": "О! Да это ж\n*Фома из седьмого «Б»!*"
},
{
"t0": 77.37,
"t1": 79.055,
"text": "Фома. *Иванович.*"
},
{
"t0": 79.505,
"t1": 81.205,
"text": "Ага. Иванович."
},
{
"t0": 81.205,
"t1": 83.525,
"text": "Так. Перекличка. Тимур?"
},
{
"t0": 83.525,
"t1": 83.945,
"text": "Тут."
},
{
"t0": 83.945,
"t1": 84.51,
"text": "Лиза?"
},
{
"t0": 84.51,
"t1": 85.625,
"text": "Присутствую."
},
{
"t0": 85.625,
"t1": 86.23,
"text": "Кеша?"
},
{
"t0": 86.23,
"t1": 86.94,
"text": "Угу."
},
{
"t0": 86.94,
"t1": 87.495,
"text": "Фома…"
},
{
"t0": 88.395,
"t1": 92.32,
"text": "А Фомы нет!\nОн, говорят, *учителем стал!*"
},
{
"t0": 93.12,
"t1": 95.29,
"text": "*Отсутствует!* Следующий!"
},
{
"t0": 95.29,
"t1": 97.77,
"text": "Так. Математика. Семь\nумножить на восемь?"
},
{
"t0": 97.77,
"t1": 98.575,
"text": "Сорок!"
},
{
"t0": 98.575,
"t1": 99.48,
"text": "А пирожок можно?"
},
{
"t0": 99.48,
"t1": 100.46,
"text": "Сто пятьсот!"
},
{
"t0": 100.46,
"t1": 101.385,
"text": "*Пятьдесят шесть.*"
},
{
"t0": 101.985,
"t1": 103.67,
"text": "...Правильно. Наверное."
},
{
"t0": 103.67,
"t1": 105.655,
"text": "Я знаю, что вы *не учитель*."
},
{
"t0": 105.655,
"t1": 107.29,
"text": "Что тебе нужно?"
},
{
"t0": 107.29,
"t1": 109.82,
"text": "*Пятёрка за четверть.*\nИ я молчу."
},
{
"t0": 110.52,
"t1": 114.07,
"text": "…Договорились.\nЛиза — к доске!"
},
{
"t0": 116.27,
"t1": 118.57,
"text": "Эй! Это мой пирожок!"
},
{
"t0": 118.57,
"t1": 120.755,
"text": "Конфискация. *Учительская.*"
},
{
"t0": 120.755,
"t1": 123.34,
"text": "Так. Посмотрим, что за новенький."
},
{
"t0": 127.19,
"t1": 128.56,
"text": "Фома *Иванович*."
},
{
"t0": 128.61,
"t1": 131.335,
"text": "Это… элемент урока.\n*Аэродинамика.*"
},
{
"t0": 131.385,
"t1": 134.63,
"text": "Контрольная. Через пять минут.\n*Проверю лично.*"
},
{
"t0": 135.23,
"t1": 139.655,
"text": "Пять минут. Контрольная.\nКоторую я *сам не напишу*."
}
]